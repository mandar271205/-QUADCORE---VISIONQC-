# Saved-model local deployment: run FastAPI from the repository root.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8001
FRONTEND_WEB_URL=http://127.0.0.1:5174
DATABASE_URL=sqlite+aiosqlite:///./visionqc.db
INSPECTION_MODE=model_only
ML_ENABLED=true
ML_MODEL_ROOT=./models
ML_EXPERIMENT_ROOT=./outputs
ML_DEVICE=cpu
ML_CACHE_SIZE=2
ML_TORCH_THREADS=4
MOBILE_USE_ML=true
DEMO_MODE=false
REVIEW_MARGIN=0
ENGINE_TIMEOUT_SECONDS=30
MAX_UPLOAD_MB=15
LOG_LEVEL=INFO
