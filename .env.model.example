# Saved-model local deployment: run FastAPI from the repository root.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8001
FRONTEND_WEB_URL=http://127.0.0.1:5174
DATABASE_URL=sqlite+aiosqlite:///./visionqc.db
INSPECTION_MODE=model_only
ML_ENABLED=true
# External Member 2 artifact mounts; keep checkpoints and experiment outputs out of this repository.
ML_MODEL_ROOT=/path/to/member2-models
ML_EXPERIMENT_ROOT=/path/to/member2-outputs
ML_DEVICE=cpu
ML_CACHE_SIZE=2
ML_TORCH_THREADS=4
# Optional Member 1 PatchCore runtime; its interpreter and artifact tree stay external.
ML_M1_ENABLED=false
ML_M1_PYTHON=/path/to/member1-infer/python
ML_M1_MODEL_ROOT=/path/to/VisionQC_Member1_Handoff
ML_M1_WORK_ROOT=
ML_M1_WORKER_STARTUP_TIMEOUT=120
ML_M1_REQUEST_TIMEOUT=35
ML_M1_CACHE_SIZE=2
MOBILE_USE_ML=true
DEMO_MODE=false
REVIEW_MARGIN=0
ENGINE_TIMEOUT_SECONDS=30
MAX_UPLOAD_MB=15
LOG_LEVEL=INFO
