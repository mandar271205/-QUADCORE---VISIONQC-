{
  "expo": {
    "name": "VisionQC",
    "slug": "visionqc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "visionqc",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f1117"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.visionqc.app",
      "infoPlist": {
        "NSCameraUsageDescription": "VisionQC uses the camera to capture product images for quality inspection.",
        "NSPhotoLibraryUsageDescription": "VisionQC needs access to your photos to upload inspection images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f1117"
      },
      "package": "com.visionqc.app",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-image-picker",
        {
          "photosPermission": "VisionQC needs access to your photos to upload inspection images."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
